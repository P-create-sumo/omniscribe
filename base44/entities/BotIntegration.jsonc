{
  "name": "BotIntegration",
  "type": "object",
  "properties": {
    "channel": {
      "type": "string",
      "enum": [
        "whatsapp",
        "telegram"
      ],
      "description": "Canale del bot (WhatsApp o Telegram)"
    },
    "agent_name": {
      "type": "string",
      "default": "expert_bot",
      "description": "Nome dell'agente collegato al canale"
    },
    "enabled": {
      "type": "boolean",
      "default": false,
      "description": "Se il canale \u00e8 attivo per questo utente"
    },
    "token": {
      "type": "string",
      "description": "Token univoco di integrazione per il canale"
    }
  },
  "required": [
    "channel"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}