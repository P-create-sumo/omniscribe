{
  "name": "Expert",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome dell'Esperto AI"
    },
    "discipline": {
      "type": "string",
      "description": "Area di competenza dell'esperto"
    },
    "description": {
      "type": "string",
      "description": "Descrizione dell'esperto"
    },
    "tone_of_voice": {
      "type": "string",
      "description": "Tono di voce dell'esperto"
    },
    "key_skills": {
      "type": "string",
      "description": "Competenze chiave (separate da virgola)"
    },
    "icon": {
      "type": "string",
      "description": "Emoji icona dell'esperto",
      "default": "\ud83e\udde0"
    },
    "color": {
      "type": "string",
      "description": "Colore tema dell'esperto"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "training",
        "active"
      ],
      "default": "draft",
      "description": "Stato dell'esperto"
    },
    "slug": {
      "type": "string",
      "description": "Slug univoco per il link pubblico condivisibile"
    },
    "is_public": {
      "type": "boolean",
      "default": false,
      "description": "Se l'esperto \u00e8 accessibile via link pubblico"
    },
    "email_gate": {
      "type": "boolean",
      "default": false,
      "description": "Se richiede email per accedere (lead generation)"
    },
    "access_code": {
      "type": "string",
      "description": "Codice d'accesso opzionale per Esperto privato (vuoto = pubblico)"
    },
    "monetization_type": {
      "type": "string",
      "enum": [
        "free",
        "one_time",
        "subscription"
      ],
      "default": "free",
      "description": "Tipo di monetizzazione: gratuito, pagamento unico o abbonamento"
    },
    "price": {
      "type": "number",
      "description": "Prezzo in euro (per one_time o subscription)"
    },
    "stripe_product_id": {
      "type": "string",
      "description": "ID prodotto Stripe (creato automaticamente)"
    },
    "stripe_price_id": {
      "type": "string",
      "description": "ID prezzo Stripe (creato automaticamente)"
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "description": "Se l'esperto \u00e8 in vetrina sulla landing"
    },
    "sources_count": {
      "type": "number",
      "default": 0,
      "description": "Numero di fonti nella knowledge base"
    },
    "conversations_count": {
      "type": "number",
      "default": 0,
      "description": "Numero di conversazioni avviate"
    }
  },
  "required": [
    "name",
    "discipline"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}